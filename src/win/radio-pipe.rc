// Windows resource source for radio-pipe native-image build.
// Compile to radio-pipe.res with the Microsoft Resource Compiler:
//   rc /nologo /fo radio-pipe.res radio-pipe.rc
// Then pass the produced .res to native-image via:
//   -H:NativeLinkerOption=src/win/radio-pipe.res

#include <winver.h>

// Application icon (icon ID 1 is picked up by Explorer as the file icon).
1 ICON "..\\main\\resources\\icon.ico"

/////////////////////////////////////////////////////////////////////////////
// Version information
/////////////////////////////////////////////////////////////////////////////

#define RP_FILE_VERSION      1,0,0,0
#define RP_PRODUCT_VERSION   1,0,0,0
#define RP_FILE_VERSION_STR  "1.0.0.0\0"
#define RP_PRODUCT_VERSION_STR "1.0\0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    RP_FILE_VERSION
 PRODUCTVERSION RP_PRODUCT_VERSION
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OpenStatic.org\0"
            VALUE "FileDescription",  "RadioPipe\0"
            VALUE "FileVersion",      RP_FILE_VERSION_STR
            VALUE "InternalName",     "radio-pipe\0"
            VALUE "LegalCopyright",   "OpenStatic.org\0"
            VALUE "OriginalFilename", "radio-pipe.exe\0"
            VALUE "ProductName",      "RadioPipe\0"
            VALUE "ProductVersion",   RP_PRODUCT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
